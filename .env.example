# ==============================================================================
# StickerHub Frontend - Environment Variables Template
# ==============================================================================

# URL da API Backend
# Em desenvolvimento: http://localhost:8000
# Em produção: URL do backend no Cloud Run (https://sticker-center-backend-git-xxxx-xx.a.run.app)
VITE_API_BASE_URL=http://localhost:8000

# Proxy local do servidor Vite
VITE_BACKEND_URL=http://localhost:8000

# Neon Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://<project_id>.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="stickercenter"
